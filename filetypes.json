{
  "description": "Filetypes mdpreview renders. Order matters: the first matching entry wins. Matching is case-insensitive. 'extensions' match *.EXT, 'names' match the basename (globs allowed), 'paths' match the whole path. 'lang' is the Tree-sitter language when it differs from the filetype; filetypes without an installed highlights query use Neovim's regex syntax. 'requires' adds a check after a glob match: 'ancestor_file' names a file that must exist in the directory above the nearest 'templates' directory, 'head_regex' must match within the first 40 lines. gen-dispatch hands a file to bat when bat claims its name or path, unless the entry sets 'prefer_over_bat'. Run ./gen-dispatch after editing.",
  "filetypes": [
    {"filetype": "markdown", "prefer_over_bat": true, "extensions": ["md", "markdown", "mdown", "mdwn", "mkd", "mkdn"]},
    {"filetype": "helm", "paths": ["*/templates/*.yaml", "*/templates/*.yml", "*/templates/*.tpl"],
     "requires": {"ancestor_file": "Chart.yaml"}},
    {"filetype": "htmldjango", "extensions": ["html", "htm", "djhtml"],
     "requires": {"head_regex": "\\{%-?\\s*(autoescape|block|comment|csrf_token|cycle|debug|extends|filter|firstof|for|if|ifchanged|include|load|lorem|now|regroup|spaceless|templatetag|url|verbatim|widthratio|with)\\b|\\{#\\s"}},
    {"filetype": "tmux", "names": [".tmux.conf", "tmux.conf", ".tmux*.conf", "tmux*.conf"]},
    {"filetype": "kitty", "names": ["kitty.conf"], "paths": ["*/kitty/*.conf"]},
    {"filetype": "hyprlang", "names": ["hyprland.conf", "hypridle.conf", "hyprlock.conf", "hyprpaper.conf"],
     "paths": ["*/hypr/*.conf"]},
    {"filetype": "i3config", "paths": ["*/.i3/config", "*/i3/config", "*/i3/config.d/*"]},
    {"filetype": "sxhkdrc", "names": ["sxhkdrc", "*.sxhkdrc"]},
    {"filetype": "zathurarc", "names": ["zathurarc", ".zathurarc"]},
    {"filetype": "neomuttrc", "names": ["neomuttrc", ".neomuttrc", "neomuttrc*"], "paths": ["*/neomutt/*rc"]},
    {"filetype": "muttrc", "names": ["muttrc", ".muttrc", "muttngrc", ".muttngrc", "muttrc*"],
     "paths": ["*/.mutt/*rc", "*/mutt/*rc"]},
    {"filetype": "rasi", "extensions": ["rasi", "rasinc"]},
    {"filetype": "readline", "names": ["inputrc", ".inputrc"]},
    {"filetype": "udevrules", "lang": "udev", "paths": ["*/udev/*.rules", "*/udev/rules.d/*.rules"]},
    {"filetype": "xdefaults", "names": [".Xdefaults", ".Xresources", ".Xpdefaults", "xdm-config", "Xresources",
     "*.Xresources"]},
    {"filetype": "xcompose", "names": [".XCompose", "XCompose"]},
    {"filetype": "systemd", "prefer_over_bat": true, "extensions": ["service", "socket", "timer", "target", "mount", "automount", "slice",
     "swap", "netdev", "network", "nspawn"]},
    {"filetype": "just", "extensions": ["just"], "names": ["justfile", ".justfile"]},
    {"filetype": "kdl", "extensions": ["kdl"]},
    {"filetype": "json5", "extensions": ["json5"]},
    {"filetype": "hjson", "extensions": ["hjson"]},
    {"filetype": "gotmpl", "extensions": ["gotmpl", "tmpl", "gohtml"]},
    {"filetype": "prisma", "extensions": ["prisma"]},
    {"filetype": "astro", "extensions": ["astro"]},
    {"filetype": "mermaid", "extensions": ["mermaid", "mmd"]},
    {"filetype": "meson", "names": ["meson.build", "meson.options", "meson_options.txt"]},
    {"filetype": "nu", "extensions": ["nu"]},
    {"filetype": "gleam", "extensions": ["gleam"]},
    {"filetype": "fennel", "extensions": ["fnl", "fnlm"], "names": [".fennelrc", "fennelrc"]},
    {"filetype": "cuda", "extensions": ["cu", "cuh"]},
    {"filetype": "po", "extensions": ["po", "pot"]},
    {"filetype": "pug", "extensions": ["pug"]},
    {"filetype": "ledger", "extensions": ["ledger", "ldg"]},
    {"filetype": "beancount", "extensions": ["beancount", "bean"]},
    {"filetype": "dts", "lang": "devicetree", "extensions": ["dts", "dtsi", "dtso"]},
    {"filetype": "ebnf", "extensions": ["ebnf"]},
    {"filetype": "cue", "extensions": ["cue"]},
    {"filetype": "dhall", "extensions": ["dhall"]},
    {"filetype": "handlebars", "lang": "glimmer", "extensions": ["hbs", "handlebars"]},
    {"filetype": "conf", "extensions": ["conf", "ctags"],
     "names": [".chktexrc", ".ripgreprc", "ripgreprc", ".x11vncrc", "auto.master", "texdoc.cnf"]}
  ]
}
