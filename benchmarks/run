#!/usr/bin/python3
"""Benchmark Markdown rendering, append the results to history.tsv, and update the table in SYNTAX.md.

Waits until the 1-minute load average is low enough, then renders each sample several times in three modes
(complete output, a 40-row viewport, and fzf's preview environment) and records the median wall time, the
median startup time (until Neovim is set up, from nvcat --timings-json) and the median peak RSS of Neovim
and of nvcat itself. The SYNTAX.md table compares the new wall-time medians with the average of all
earlier runs.
"""

import argparse
import json
import os
import statistics
import subprocess
import sys
import time

from common import HERE, ROOT, load1, metadata, wait_for_load
HISTORY = HERE / "history.tsv"
SYNTAX = ROOT / "SYNTAX.md"
SAMPLES = ["small", "medium", "large", "code"]
COLUMNS, LINES = 100, 40
# fzf: no size flags; nvcat takes the size from fzf's variables and emits one viewport, as in a preview.
MODES = {
  "complete": (["--all", "--budget", "0"], {}),
  "viewport": (["--lines", str(LINES)], {}),
  "fzf": ([], {"FZF_PREVIEW_COLUMNS": str(COLUMNS), "FZF_PREVIEW_LINES": str(LINES)}),
}
# Phases up to a ready Neovim (nvcat --timings-json). Python's own interpreter start precedes them.
STARTUP_PHASES = ["python imports", "config", "input and filetype", "startup"]
FIELDS = ["date", "version", "commit", "sample", "mode", "median_ms", "min_ms", "runs", "load1", "nvim",
          "startup_ms", "nvim_rss_mib", "python_rss_mib"]
START, END = "<!-- benchmark:start -->", "<!-- benchmark:end -->"


def measure(sample, mode, runs, timeout):
  """Median and minimum wall ms, median startup ms, and median peak RSS (MiB) of Neovim and of nvcat."""
  flags, variables = MODES[mode]
  size = [] if variables else ["--columns", str(COLUMNS)]
  command = [str(ROOT / "nvcat"), "--paging=never", *size, "--timeout", str(timeout), "--timings-json",
             *flags, str(HERE / f"{sample}.md")]
  environment = {name: value for name, value in os.environ.items()
                 if name not in ("FZF_PREVIEW_COLUMNS", "FZF_PREVIEW_LINES", "NVIM")}
  environment.update(variables)
  times, startups, nvim_rss, python_rss = [], [], [], []
  for index in range(runs + 1):  # The first run warms the page cache and is discarded.
    start = time.perf_counter()
    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=environment)
    elapsed = (time.perf_counter() - start) * 1000
    stderr = result.stderr.decode(errors="replace").strip()
    try:
      report = json.loads(stderr)  # Anything else on stderr (a warning, a fallback notice) fails the run.
    except ValueError:
      report = None
    if result.returncode != 0 or not result.stdout or report is None:
      raise SystemExit(f"benchmark: {sample}/{mode} failed: {stderr}")
    if index:
      times.append(elapsed)
      startups.append(sum(report["phases"].get(name, 0) for name in STARTUP_PHASES))
      nvim_rss.append(report["peak_rss_kb"]["children"] / 1024)
      python_rss.append(report["peak_rss_kb"]["python"] / 1024)
  return {"median_ms": round(statistics.median(times)), "min_ms": round(min(times)),
          "startup_ms": round(statistics.median(startups)), "nvim_rss_mib": round(statistics.median(nvim_rss)),
          "python_rss_mib": round(statistics.median(python_rss))}


def read_history():
  if not HISTORY.exists():
    return []
  lines = HISTORY.read_text().splitlines()
  return [dict(zip(FIELDS, line.split("\t"))) for line in lines[1:] if line]


def append_history(rows):
  header = "\t".join(FIELDS)
  if HISTORY.exists():
    lines = HISTORY.read_text().splitlines()
    if lines and lines[0] != header:  # New columns are appended; earlier rows simply lack them.
      HISTORY.write_text("\n".join([header, *lines[1:]]) + "\n")
  else:
    HISTORY.write_text(header + "\n")
  with open(HISTORY, "a", encoding="utf-8") as handle:
    for row in rows:
      handle.write("\t".join(str(row[field]) for field in FIELDS) + "\n")


def sample_stats(sample):
  text = (HERE / f"{sample}.md").read_text()
  return len(text.splitlines()), sum(1 for line in text.splitlines() if line.startswith("```") and line != "```")


def table(rows, previous):
  first = rows[0]
  out = [
    START,
    "",
    f"Latest run: {first['date']}, version {first['version']} ({first['commit']}), load {first['load1']}, "
    f"{first['nvim']}. Median of {first['runs']} runs after one warm-up, {COLUMNS} columns; complete output "
    f"uses `--all --budget 0`, viewport `--lines {LINES}`, fzf sets `FZF_PREVIEW_COLUMNS={COLUMNS}` and "
    f"`FZF_PREVIEW_LINES={LINES}` (the time to the first usable fzf preview). Startup is the time until Neovim "
    "is set up (`--timings`), excluding Python's interpreter start; RSS is the peak of Neovim and of "
    "nvcat's Python. Averages compare wall time with all earlier runs in "
    "[benchmarks/history.tsv](benchmarks/history.tsv); regenerate with `benchmarks/run`.",
    "",
    "| Sample | Lines | Code blocks | Mode | Latest (ms) | Average (ms) | Runs averaged | vs average | "
    "Startup (ms) | Neovim RSS (MiB) | Python RSS (MiB) |",
    "|---|---:|---:|---|---:|---:|---:|---:|---:|---:|---:|",
  ]
  for row in rows:
    lines, blocks = sample_stats(row["sample"])
    earlier = [float(item["median_ms"]) for item in previous
               if item["sample"] == row["sample"] and item["mode"] == row["mode"]]
    if earlier:
      average = statistics.fmean(earlier)
      change = f"{(row['median_ms'] - average) / average * 100:+.0f}%"
      average_text = f"{average:.0f}"
    else:
      change, average_text = "first run", "-"
    out.append(f"| [{row['sample']}](benchmarks/{row['sample']}.md) | {lines} | {blocks} | {row['mode']} | "
               f"{row['median_ms']:.0f} | {average_text} | {len(earlier)} | {change} | {row['startup_ms']} | "
               f"{row['nvim_rss_mib']} | {row['python_rss_mib']} |")
  out += ["", END]
  return "\n".join(out)


def update_syntax(block):
  text = SYNTAX.read_text()
  if START in text and END in text:
    text = text[:text.index(START)] + block + text[text.index(END) + len(END):]
  else:
    anchor = "## Neovim treesitter filetypes not in bat"
    section = "## Markdown rendering benchmarks\n\n" + block + "\n\n"
    text = text.replace(anchor, section + anchor, 1) if anchor in text else text + "\n" + section
  SYNTAX.write_text(text)


def main():
  parser = argparse.ArgumentParser(description=__doc__)
  parser.add_argument("--runs", type=int, default=3, help="Measured runs per sample and mode (default: 3)")
  parser.add_argument("--max-load", type=float, default=max(1.0, (os.cpu_count() or 1) * 0.6),
                      help="Highest 1-minute load average to start at (default: 0.6 x CPUs)")
  parser.add_argument("--max-wait", type=float, default=900, help="Seconds to wait for the load (default: 900)")
  parser.add_argument("--interval", type=float, default=15, help="Seconds between load checks (default: 15)")
  parser.add_argument("--timeout", type=int, default=60, help="nvcat --timeout per render (default: 60)")
  parser.add_argument("--dry-run", action="store_true", help="Print the table without recording anything")
  args = parser.parse_args()
  if not wait_for_load(args.max_load, args.max_wait, args.interval):
    raise SystemExit(f"benchmark: load stayed above {args.max_load:.2f} for {args.max_wait:.0f}s; nothing recorded")
  base = dict(metadata(), runs=args.runs)
  rows = []
  for sample in SAMPLES:
    for mode in MODES:
      result = measure(sample, mode, args.runs, args.timeout)
      rows.append(dict(base, sample=sample, mode=mode, **result))
      print(f"{sample:7} {mode:9} {result['median_ms']:7d} ms  startup {result['startup_ms']:4d} ms  "
            f"nvim {result['nvim_rss_mib']:4d} MiB", file=sys.stderr, flush=True)
  previous = read_history()
  block = table(rows, previous)
  if args.dry_run:
    print(block)
    return 0
  append_history(rows)
  update_syntax(block)
  print(block)
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
