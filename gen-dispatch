#!/usr/bin/python3
"""Generate mdpreview-dispatch, a fast bash router between mdpreview and bat, from filetypes.json."""

import argparse
from pathlib import Path
import re
import shlex
import subprocess
import sys

import filetypes

ROOT = Path(__file__).resolve().parent


def bat_patterns():
  """Return (version, [(syntax, bash pattern)]) for every file name, path, and glob bat claims."""
  version = subprocess.run(["bat", "--version"], capture_output=True, text=True, check=True).stdout.split()[1]
  listing = subprocess.run(["bat", "--list-languages"], capture_output=True, text=True, check=True).stdout
  lines = [line.split(":", 1) for line in listing.splitlines() if ":" in line]
  config = subprocess.run(["bat", "--config-file"], capture_output=True, text=True, check=True).stdout.strip()
  if Path(config).is_file():
    for glob, syntax in re.findall(r'--map-syntax[= ]"?([^":\s]+):([^"\n]+)"?', Path(config).read_text()):
      lines.append([syntax.strip(), glob])
  patterns = []
  for syntax, tokens in lines:
    for token in tokens.split(","):
      token = token.strip()
      if not token:
        continue
      if "/" in token or "*" in token:
        glob = token.replace("/**/", "/*").replace("**/", "*/").replace("**", "*")
        patterns.append((syntax, glob if glob.startswith(("/", "*")) else "*/" + glob))
      else:
        patterns += [(syntax, f"*.{token}"), (syntax, token), (syntax, f"*/{token}")]
  return version, patterns


def sample(pattern):
  return ("/" if not pattern.startswith("/") else "") + pattern.replace("*", "x")


def bash_pattern(glob):
  """Quote a glob for a case label, keeping only * and ? special."""
  return "".join(character if character in "*?" else shlex.quote(character) if not character.isalnum()
                 and character not in "._-/" else character for character in glob)


def requirement(entry):
  requires = entry.get("requires", {})
  checks = []
  if "ancestor_file" in requires:
    checks.append(f'[[ -f ${{1%/templates/*}}/{bash_pattern(requires["ancestor_file"])} ]]')
  if "head_regex" in requires:
    checks.append(f'head -n {filetypes.HEAD_LINES} -- "$1" 2>/dev/null | grep -qiE -- '
                  + shlex.quote(requires["head_regex"]))
  return " && ".join(checks)


def generate(entries, version, patterns):
  claimed = []
  for syntax, pattern in patterns:
    entry = filetypes.detect(sample(pattern), entries)
    if entry and not entry.get("prefer_over_bat") and pattern not in [item[1] for item in claimed]:
      claimed.append((syntax, pattern))
  out = [
    "#!/usr/bin/env bash",
    f"# Generated by ./gen-dispatch from filetypes.json and bat {version}. Do not edit; regenerate instead.",
    "#",
    "# Usage: mdpreview-dispatch FILE          render FILE with mdpreview, else with bat",
    "#        mdpreview-dispatch --print FILE  print the mdpreview filetype; exit 1 when bat handles FILE",
    "#",
    "# MDPREVIEW and BAT override the commands. mdpreview errors are discarded and the file goes to bat.",
    "",
    "detect() {",
    "  REPLY=",
  ]
  if claimed:
    out.append("  case $1 in")
    for syntax, pattern in claimed:
      out.append(f"    {bash_pattern(pattern)}) return 1 ;;  # bat: {syntax}")
    out.append("  esac")
  for entry in entries:
    labels = " | ".join(bash_pattern(glob) for glob in filetypes.globs(entry))
    check = requirement(entry)
    action = f"{check} && {{ REPLY={entry['filetype']}; return 0; }}" if check else \
      f"REPLY={entry['filetype']}; return 0"
    out.append(f"  case $1 in {labels}) {action} ;; esac")
  out += [
    "  return 1",
    "}",
    "",
    "print=0",
    "if [[ ${1-} == --print ]]; then print=1; shift; fi",
    "if [[ $# -ne 1 ]]; then",
    "  echo 'usage: mdpreview-dispatch [--print] FILE' >&2",
    "  exit 2",
    "fi",
    "file=$1",
    "path=$file",
    "[[ $path == /* ]] || path=$PWD/$path",
    "shopt -s nocasematch",
    "filetype=",
    "if [[ -f $file ]] && detect \"$path\"; then filetype=$REPLY; fi",
    "shopt -u nocasematch",
    "if (( print )); then",
    "  [[ -n $filetype ]] && printf '%s\\n' \"$filetype\" && exit 0",
    "  exit 1",
    "fi",
    "if [[ -n $filetype ]] && command -v \"${MDPREVIEW:-mdpreview}\" >/dev/null 2>&1; then",
    "  \"${MDPREVIEW:-mdpreview}\" --all --paging=never --budget=2 --filetype \"$filetype\" -- \"$file\" 2>/dev/null && exit 0",
    "fi",
    "exec \"${BAT:-bat}\" --color=always --paging=never -- \"$file\"",
  ]
  return "\n".join(out) + "\n", claimed


def main():
  parser = argparse.ArgumentParser(description=__doc__)
  parser.add_argument("--output", type=Path, default=ROOT / "mdpreview-dispatch", help="Script to write, or - for stdout")
  args = parser.parse_args()
  version, patterns = bat_patterns()
  script, claimed = generate(filetypes.load(), version, patterns)
  if str(args.output) == "-":
    sys.stdout.write(script)
  else:
    args.output.write_text(script)
    args.output.chmod(0o755)
    print(f"Wrote {args.output} ({len(claimed)} bat-claimed patterns)", file=sys.stderr)
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
